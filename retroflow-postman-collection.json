  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "if (name.includes('[NEGATIVE]') || name.includes('[PROBE]')) {",
          "  pm.test('Request is rejected with a 4xx response', function () {",
          "    pm.expect(pm.response.code).to.be.within(400, 499);",
          "  });",
          "} else if (name.includes('[EITHER]')) {",
          "  pm.test('Request does not cause a server error', function () {",
          "    pm.expect(pm.response.code).to.be.below(500);",
          "  });",
          "} else {",
          "  pm.test('Request succeeds with a 2xx response', function () {",
          "    pm.expect(pm.response.code).to.be.within(200, 299);",
          "  });",
          "}",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "  const body = pm.response.json();",
          "  if (name.includes('TEAM-01 Create')) pm.collectionVariables.set('teamId', body.id);",
          "  if (name.includes('TEAM-02 Create')) pm.collectionVariables.set('teamId2', body.id);",
          "  if (name.includes('RETRO-01 Create')) pm.collectionVariables.set('retroId', body.id);",
          "  if (name.includes('RETRO-03 Create')) pm.collectionVariables.set('newRetroId', body.id);",
          "  if (name.includes('FEEDBACK-01 Add')) pm.collectionVariables.set('feedbackId', body.id);",
          "}"
        ]
      }
    }
  ],
