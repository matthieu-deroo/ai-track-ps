{
  "info": {
    "_postman_id": "d998aaf0-f713-4f16-9990-7f6a4e9525e1",
    "name": "RetroFlow QA - Core Business Rules",
    "description": "Manual and runner-ready API checks for RetroFlow team creation, retrospective lifecycle, and feedback immutability. Run requests in order. The collection creates test data in the configured shared QA service; it does not clean up records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ai-track-ps-test-retroflow-production.up.railway.app",
      "type": "string"
    },
    {
      "key": "teamId",
      "value": "",
